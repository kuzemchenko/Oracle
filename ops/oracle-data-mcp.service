[Unit]
Description=Oracle read-only MCP data bridge
After=network-online.target

[Service]
Type=simple
User=oracle
WorkingDirectory=/home/oracle/oracle
ExecStart=/bin/bash -c 'set -a; source .env; source .env.advisor; exec .venv-advisor/bin/python -m advisor.server'
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/oracle/oracle/storage

[Install]
WantedBy=multi-user.target
