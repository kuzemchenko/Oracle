# Existing Oracle .env provides EODHD_API_KEY and NEWSAPI_AI_KEY.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ORACLE_MCP_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ORACLE_MCP_PORT=8765
# Exact HTTPS reverse-proxy hostname; no scheme or path.
ORACLE_MCP_HOSTS=oracle-data.example.com
