# Public HTTPS deployment only. Pilot obtains its temporary URL automatically.
ORACLE_PUBLIC_URL=https://oracle-data.example.com
# Generate locally, keep private: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ORACLE_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD_AT_LEAST_32_CHARACTERS
ORACLE_DATA_ROOT=/home/oracle/oracle
# EODHD_API_KEY and NEWSAPI_AI_KEY are loaded from the existing Oracle .env.
